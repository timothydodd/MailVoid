{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.AspNetCore.Authentication": "Warning",
            "Microsoft.AspNetCore.Authorization": "Warning",
            "Microsoft": "Information",
            "Microsoft.Hosting.Lifetime": "Information",
            "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
            "MailVoidApi": "Information"
        }
    },
    "AllowedHosts": "*",
    "CorsOrigins": [
        "http://localhost:6200"
    ],
    "ConnectionStrings": {
        "DefaultConnection": "Data Source=mailvoid.db"
    },
    "JwtSettings": {
        "Secret": "your_secret_key_here",
        "Issuer": "mailvoid",
        "Audience": "mailvoid",
        "ExpiryMinutes": 30,
        "RefreshTokenExpiryDays": 30,
        "RefreshTokenCookieSameSite": "None",
        "RefreshTokenCookieSecure": true
    },
    "ApiKeys": [
        {
            "Name": "Mail Server Webhook",
            "Key": "webhook-api-key-change-this-in-production",
            "Enabled": false,
            "Scopes": [ "webhook" ]
        }
    ]
}
